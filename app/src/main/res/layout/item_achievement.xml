<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/card_background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Achievement Icon -->
        <TextView
            android:id="@+id/tvAchievementIcon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_achievement_icon"
            android:gravity="center"
            android:text="🏆"
            android:textSize="32sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Lock Overlay (for locked achievements) -->
        <View
            android:id="@+id/viewLockOverlay"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:alpha="0.7"
            android:background="@color/gray_medium"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/tvAchievementIcon"
            app:layout_constraintEnd_toEndOf="@id/tvAchievementIcon"
            app:layout_constraintStart_toStartOf="@id/tvAchievementIcon"
            app:layout_constraintTop_toTopOf="@id/tvAchievementIcon" />

        <!-- Achievement Title -->
        <TextView
            android:id="@+id/tvAchievementTitle"
            style="@style/BodyLarge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:text="Achievement Title"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/tvStatus"
            app:layout_constraintStart_toEndOf="@id/tvAchievementIcon"
            app:layout_constraintTop_toTopOf="@id/tvAchievementIcon" />

        <!-- Achievement Description -->
        <TextView
            android:id="@+id/tvAchievementDesc"
            style="@style/BodyMedium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Achievement description"
            app:layout_constraintEnd_toEndOf="@id/tvAchievementTitle"
            app:layout_constraintStart_toStartOf="@id/tvAchievementTitle"
            app:layout_constraintTop_toBottomOf="@id/tvAchievementTitle" />

        <!-- Progress/Date -->
        <TextView
            android:id="@+id/tvProgress"
            style="@style/BodyMedium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Progress: 0/10"
            android:textColor="@color/primary_blue"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="@id/tvAchievementTitle"
            app:layout_constraintStart_toStartOf="@id/tvAchievementTitle"
            app:layout_constraintTop_toBottomOf="@id/tvAchievementDesc" />

        <!-- Status Badge -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_badge"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            android:text="🔒 Locked"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>